{
  "openapi": "3.0.3",
  "info": {
    "description": "This is a MongoDB Backend reflector server. Supporting front-end only application to deploy their own backend via PAAS platform to transmit their database data.",
    "version": "1.0.1",
    "title": "Mongo Reflector",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "https://nodejs-mongoreflector.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Health Check",
      "description": "Server connectivity verification"
    },
    {
      "name": "Read Operations",
      "description": "Query and retrieve data from MongoDB"
    },
    {
      "name": "Write Operations",
      "description": "Insert and update data in MongoDB"
    },
    {
      "name": "Delete Operations",
      "description": "Delete data from MongoDB collections"
    },
    {
      "name": "TimeSeries Operations",
      "description": "Special operations for TimeSeries collections"
    }
  ],
  "paths": {
    "/ping": {
      "post": {
        "tags": [
          "Health Check"
        ],
        "summary": "Check MongoDB connectivity",
        "description": "Verifies connection to MongoDB server",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB connection string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection name",
                    "example": "testCollection"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connection successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Cloud connection successful"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required parameters"
          },
          "500": {
            "description": "Connection failed"
          }
        }
      }
    },
    "/find": {
      "post": {
        "tags": [
          "Read Operations"
        ],
        "summary": "Find documents in MongoDB",
        "description": "Query documents with optional filtering",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB connection string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection name",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "MongoDB query filter",
                    "example": {
                      "status": "active"
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "Find options (projection, sort, etc)",
                    "example": {
                      "projection": { "name": 1, "email": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/paginatefind": {
      "post": {
        "tags": [
          "Read Operations"
        ],
        "summary": "Find documents with pagination (DataTables protocol)",
        "description": "Query documents with support for pagination, sorting, and global search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "Base filter",
                    "example": {}
                  },
                  "start": {
                    "type": "integer",
                    "description": "Skip documents count",
                    "example": 0
                  },
                  "length": {
                    "type": "integer",
                    "description": "Limit documents count",
                    "example": 10
                  },
                  "columns": {
                    "type": "array",
                    "description": "Column definitions",
                    "example": [
                      {
                        "data": "name"
                      },
                      {
                        "data": "email"
                      }
                    ]
                  },
                  "order": {
                    "type": "array",
                    "description": "Sort order",
                    "example": [
                      {
                        "column": 0,
                        "dir": "asc"
                      }
                    ]
                  },
                  "search": {
                    "type": "object",
                    "description": "Global search",
                    "example": {
                      "value": ""
                    }
                  },
                  "draw": {
                    "type": "integer",
                    "description": "Draw counter from DataTables",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "draw": {
                      "type": "integer"
                    },
                    "recordsTotal": {
                      "type": "integer",
                      "description": "Total records in collection"
                    },
                    "recordsFiltered": {
                      "type": "integer",
                      "description": "Records matching filter"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/distinct_field": {
      "post": {
        "tags": [
          "Read Operations"
        ],
        "summary": "Get distinct values for a field",
        "description": "Returns array of unique values for specified field",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "field_name"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "field_name": {
                    "type": "string",
                    "description": "Field name to get distinct values from",
                    "example": "status"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": ["active", "inactive", "pending"]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/insert": {
      "post": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Insert documents into MongoDB",
        "description": "Insert single or multiple documents. Handles both single object and array",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "documents"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "documents": {
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "Single document",
                        "example": {
                          "name": "John",
                          "email": "john@example.com"
                        }
                      },
                      {
                        "type": "array",
                        "description": "Multiple documents",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  },
                  "options": {
                    "type": "object",
                    "description": "Insert options",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insert successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "insertedId": {
                          "type": "string"
                        },
                        "insertedIds": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "get": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Example request for /insert",
        "responses": {
          "200": {
            "description": "Example",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/insertTimeseries": {
      "post": {
        "tags": [
          "Write Operations",
          "TimeSeries Operations"
        ],
        "summary": "Insert data into TimeSeries collection",
        "description": "Insert data into a TimeSeries collection with automatic timestamp field handling",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "timeField", "documents"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB connection string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "TimeSeries collection name",
                    "example": "myTimeSeries"
                  },
                  "timeField": {
                    "type": "object",
                    "description": "Time field specification",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Time field name",
                        "example": "timestamp"
                      },
                      "val": {
                        "type": "string",
                        "description": "ISO 8601 datetime string",
                        "example": "2026-01-18T10:30:00Z"
                      }
                    }
                  },
                  "documents": {
                    "type": "object",
                    "description": "Document to insert",
                    "example": {
                      "metadata": {
                        "sensor": "temp_01"
                      },
                      "value": 23.5
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "Insert options",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insert successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "description": "Insert result with insertedId"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/update": {
      "post": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Update documents in MongoDB",
        "description": "Update documents with automatic upsert enabled by default",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query", "update"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "Query filter",
                    "example": {
                      "_id": "123"
                    }
                  },
                  "update": {
                    "type": "object",
                    "description": "Update operators",
                    "example": {
                      "$set": {
                        "status": "updated"
                      }
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "Update options (default: upsert: true)",
                    "example": {
                      "upsert": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "matchedCount": {
                      "type": "integer"
                    },
                    "modifiedCount": {
                      "type": "integer"
                    },
                    "upsertedCount": {
                      "type": "integer"
                    },
                    "upsertedId": {
                      "type": ["string", "null"]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "get": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Example request for /update",
        "responses": {
          "200": {
            "description": "Example",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delete": {
      "post": {
        "tags": [
          "Delete Operations"
        ],
        "summary": "Delete documents from MongoDB",
        "description": "Delete one or multiple documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "Query filter",
                    "example": {
                      "_id": "123"
                    }
                  },
                  "multi": {
                    "type": "boolean",
                    "description": "Delete multiple documents (deleteMany) or single (deleteOne)",
                    "example": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deletedCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/deleteTimeseries": {
      "post": {
        "tags": [
          "Delete Operations",
          "TimeSeries Operations"
        ],
        "summary": "Delete documents from TimeSeries collection",
        "description": "Delete documents with support for time range filtering. Uses deleteMany by default",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "myTimeSeries"
                  },
                  "query": {
                    "type": "object",
                    "description": "Base filter",
                    "example": {
                      "metadata.sensor": "temp_01"
                    }
                  },
                  "timeField": {
                    "type": "object",
                    "description": "Optional time range filter",
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "ISO 8601 start datetime",
                        "example": "2026-01-01T00:00:00Z"
                      },
                      "end": {
                        "type": "string",
                        "description": "ISO 8601 end datetime",
                        "example": "2026-01-31T23:59:59Z"
                      }
                    }
                  },
                  "multi": {
                    "type": "boolean",
                    "description": "Delete multiple (deleteMany) or single (deleteOne)",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "deletedCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/deleteTimeseries_legacy": {
      "post": {
        "tags": [
          "Delete Operations",
          "TimeSeries Operations"
        ],
        "summary": "Delete documents from TimeSeries collection (Legacy - MongoDB 6 compatible)",
        "description": "Delete documents one-by-one for better compatibility with older MongoDB versions. Processes matching documents and deletes them individually",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "myTimeSeries"
                  },
                  "query": {
                    "type": "object",
                    "description": "Base filter",
                    "example": {
                      "metadata.sensor": "temp_01"
                    }
                  },
                  "timeField": {
                    "type": "object",
                    "description": "Optional time range filter",
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "ISO 8601 start datetime",
                        "example": "2026-01-01T00:00:00Z"
                      },
                      "end": {
                        "type": "string",
                        "description": "ISO 8601 end datetime",
                        "example": "2026-01-31T23:59:59Z"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "deletedCount": {
                      "type": "integer",
                      "description": "Number of successfully deleted documents"
                    },
                    "failedCount": {
                      "type": "integer",
                      "description": "Number of documents failed to delete"
                    },
                    "totalMatched": {
                      "type": "integer",
                      "description": "Total documents matching the filter"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}
