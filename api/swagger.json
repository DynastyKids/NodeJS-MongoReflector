{
  "openapi": "3.0.3",
  "info": {
    "description": "This is a MongoDB Backend reflector server. Supporting front-end only application to deploy their own backend via PAAS platform to transmit their database data.",
    "version": "1.0.1",
    "title": "Mongo Reflector",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": [
        "https://mongoreflector-testing.onrender.com/"
      ]
    }
  ],
  "tags": [
    {
      "name": "Samples",
      "description": "GET requests are for user to check the sample JSON format that should be used in post requests"
    },
    {
      "name": "Requests",
      "description": "POST requests are actural method that user needs for sending requests."
    }
  ],
"components": {
    "schemas": {
      "MongoBaseRequest": {
        "type": "object",
        "required": [
          "mongoURI",
          "dbName",
          "collectionName"
        ],
        "properties": {
          "mongoURI": {
            "type": "string",
            "description": "MongoDB connection string (Atlas URI). / MongoDB 连接字符串 (Atlas 地址)。",
            "example": "mongodb+srv://user:pass@cluster.mongodb.net"
          },
          "dbName": {
            "type": "string",
            "description": "Target database name. / 目标数据库名称。",
            "example": "production_db"
          },
          "collectionName": {
            "type": "string",
            "description": "Target collection name. / 目标集合名称。",
            "example": "orders"
          }
        }
      }
    }
  },
  "paths": {
    "/ping": {
      "post": {
        "summary": "Test Connection / 测试连接",
        "description": "Verify if the provided URI can connect to the database. / 验证提供的 URI 是否能成功连接数据库。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MongoBaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success / 成功",
            "content": {
              "application/json": {
                "example": {
                  "acknowledged": true,
                  "message": "ping successful"
                }
              }
            }
          }
        }
      }
    },
    "/find": {
      "post": {
        "summary": "General Query / 通用查询",
        "description": "Fetch data based on query object. Supports RegExp(pattern, flags). / 根据查询对象获取数据。支持正则字符串转换。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/MongoBaseRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "query": {
                        "type": "object",
                        "description": "MongoDB Filter object. / MongoDB 过滤对象。",
                        "example": {
                          "status": "A",
                          "tags": "RegExp(cloud, i)"
                        }
                      },
                      "options": {
                        "type": "object",
                        "description": "Projection, sort, etc. / 投影、排序等选项。",
                        "example": {
                          "sort": {
                            "date": -1
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Results found / 返回查询结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/paginatefind": {
      "post": {
        "summary": "DataTables Pagination / 分页查询",
        "description": "Advanced pagination compatible with DataTables frontend plugin. / 适配 DataTables 前端插件的高级分页查询。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/MongoBaseRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "draw": {
                        "type": "integer"
                      },
                      "start": {
                        "type": "integer",
                        "description": "Skip count. / 跳过的记录数。"
                      },
                      "length": {
                        "type": "integer",
                        "description": "Page size. / 每页长度。"
                      },
                      "search": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paginated Data / 分页数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "draw": {
                      "type": "integer"
                    },
                    "recordsTotal": {
                      "type": "integer"
                    },
                    "recordsFiltered": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/distinct_field": {
      "post": {
        "summary": "Distinct Values / 唯一值查询",
        "description": "Get all unique values of a specific field. / 获取指定字段的所有唯一值。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/MongoBaseRequest"
                  },
                  {
                    "type": "object",
                    "required": [
                      "field_name"
                    ],
                    "properties": {
                      "field_name": {
                        "type": "string",
                        "description": "Field to perform distinct on. / 要执行去重的字段名。",
                        "example": "user_role"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unique list / 唯一值列表",
            "content": {
              "application/json": {
                "example": {
                  "acknowledged": true,
                  "results": [
                    "Admin",
                    "Editor",
                    "User"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}