{
  "openapi": "3.0.3",
  "info": {
    "description": "This is a MongoDB Backend reflector server. Supporting front-end only application to deploy their own backend via PAAS platform to transmit their database data.",
    "version": "1.0.1",
    "title": "Mongo Reflector",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "https://nodejs-mongoreflector.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Health Check",
      "description": "Server connectivity verification"
    },
    {
      "name": "Read Operations",
      "description": "Query and retrieve data from MongoDB"
    },
    {
      "name": "Write Operations",
      "description": "Insert and update data in MongoDB"
    },
    {
      "name": "Delete Operations",
      "description": "Delete data from MongoDB collections"
    },
    {
      "name": "TimeSeries Operations",
      "description": "Special operations for TimeSeries collections"
    }
  ],
  "paths": {
    "/test": {
      "get": {
        "tags": [
          "Health Check"
        ],
        "summary": "Basic service test",
        "description": "Returns static JSON confirming the service is running",
        "responses": {
          "200": {
            "description": "Test response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "example": "MONGOREFLECTOR" },
                    "test": { "type": "string", "example": "OK" },
                    "version": { "type": "string", "example": "0.1.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "post": {
        "tags": [
          "Health Check"
        ],
        "summary": "Check MongoDB connectivity",
        "description": "Verifies connection to MongoDB server",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB connection string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection name",
                    "example": "testCollection"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connection successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Cloud connection successful"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required parameters"
          },
          "500": {
            "description": "Connection failed"
          }
        }
      }
    },
    "/find": {
      "post": {
        "tags": [
          "Read Operations"
        ],
        "summary": "Find documents in MongoDB",
        "description": "Query documents with optional filtering. Results are streamed internally and truncated when the JSON payload reaches 32MB (MAX_FIND_RESPONSE_BYTES).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB connection string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "Collection name",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "MongoDB query filter",
                    "example": {
                      "status": "active"
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "Find options (projection, sort, etc)",
                    "example": {
                      "projection": { "name": 1, "email": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "truncated": {
                      "type": "boolean",
                      "description": "True when response was truncated due to payload limit",
                      "example": false
                    },
                    "maxPayloadBytes": {
                      "type": "integer",
                      "description": "Maximum response payload size in bytes",
                      "example": 33554432
                    },
                    "payloadBytes": {
                      "type": "integer",
                      "description": "Estimated JSON payload size returned in bytes",
                      "example": 18432
                    },
                    "scanned": {
                      "type": "integer",
                      "description": "Number of documents scanned from MongoDB cursor",
                      "example": 120
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/paginatefind": {
      "post": {
        "tags": [
          "Read Operations"
        ],
        "summary": "Find documents with pagination (DataTables protocol)",
        "description": "Query documents with pagination, sorting, and global search. `length` is clamped to MAX_PAGINATE_LENGTH (default 500). Page payload is truncated at 32MB if needed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "Base filter",
                    "example": {}
                  },
                  "start": {
                    "type": "integer",
                    "description": "Skip documents count",
                    "example": 0
                  },
                  "length": {
                    "type": "integer",
                    "description": "Limit documents count (clamped to max 500 by default)",
                    "example": 10
                  },
                  "columns": {
                    "type": "array",
                    "description": "Column definitions",
                    "example": [
                      {
                        "data": "name"
                      },
                      {
                        "data": "email"
                      }
                    ]
                  },
                  "order": {
                    "type": "array",
                    "description": "Sort order",
                    "example": [
                      {
                        "column": 0,
                        "dir": "asc"
                      }
                    ]
                  },
                  "search": {
                    "type": "object",
                    "description": "Global search",
                    "example": {
                      "value": ""
                    }
                  },
                  "draw": {
                    "type": "integer",
                    "description": "Draw counter from DataTables",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "draw": {
                      "type": "integer"
                    },
                    "recordsTotal": {
                      "type": "integer",
                      "description": "Total records in collection"
                    },
                    "recordsFiltered": {
                      "type": "integer",
                      "description": "Records matching filter"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "truncated": {
                      "type": "boolean",
                      "description": "True when response was truncated due to payload limit"
                    },
                    "maxPayloadBytes": {
                      "type": "integer",
                      "description": "Maximum response payload size in bytes",
                      "example": 33554432
                    },
                    "payloadBytes": {
                      "type": "integer",
                      "description": "Estimated JSON payload size returned in bytes"
                    },
                    "scanned": {
                      "type": "integer",
                      "description": "Number of documents scanned from MongoDB cursor for this page"
                    },
                    "effectiveLength": {
                      "type": "integer",
                      "description": "Effective length used by server after clamping"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/distinct_field": {
      "post": {
        "tags": [
          "Read Operations"
        ],
        "summary": "Get distinct values for a field",
        "description": "Returns unique values for specified field using cursor-based aggregation. Results are limited by value count and 32MB payload cap.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "field_name"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "field_name": {
                    "type": "string",
                    "description": "Field name to get distinct values from",
                    "example": "status"
                  },
                  "query": {
                    "type": "object",
                    "description": "Optional filter applied before collecting distinct values",
                    "example": {
                      "tenantId": "acme"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": ["active", "inactive", "pending"]
                    },
                    "truncated": {
                      "type": "boolean",
                      "description": "True when response was truncated by size or value-count limit"
                    },
                    "maxPayloadBytes": {
                      "type": "integer",
                      "description": "Maximum response payload size in bytes",
                      "example": 33554432
                    },
                    "payloadBytes": {
                      "type": "integer",
                      "description": "Estimated JSON payload size returned in bytes"
                    },
                    "scanned": {
                      "type": "integer",
                      "description": "Number of grouped records scanned from aggregation cursor"
                    },
                    "maxValues": {
                      "type": "integer",
                      "description": "Maximum number of distinct values returned",
                      "example": 10000
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (for example, missing field_name)"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/insert": {
      "post": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Insert documents into MongoDB",
        "description": "Insert single or multiple documents. Handles both single object and array",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "documents"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "documents": {
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "Single document",
                        "example": {
                          "name": "John",
                          "email": "john@example.com"
                        }
                      },
                      {
                        "type": "array",
                        "description": "Multiple documents",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  },
                  "options": {
                    "type": "object",
                    "description": "Insert options",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insert successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "insertedId": {
                          "type": "string"
                        },
                        "insertedIds": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "get": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Example request for /insert",
        "responses": {
          "200": {
            "description": "Example",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/insertTimeseries": {
      "post": {
        "tags": [
          "Write Operations",
          "TimeSeries Operations"
        ],
        "summary": "Insert data into TimeSeries collection",
        "description": "Insert data into a TimeSeries collection with automatic timestamp field handling",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "timeField", "documents"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB connection string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "TimeSeries collection name",
                    "example": "myTimeSeries"
                  },
                  "timeField": {
                    "type": "object",
                    "description": "Time field specification",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Time field name",
                        "example": "timestamp"
                      },
                      "val": {
                        "type": "string",
                        "description": "ISO 8601 datetime string",
                        "example": "2026-01-18T10:30:00Z"
                      }
                    }
                  },
                  "documents": {
                    "type": "object",
                    "description": "Document to insert",
                    "example": {
                      "metadata": {
                        "sensor": "temp_01"
                      },
                      "value": 23.5
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "Insert options",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insert successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "description": "Insert result with insertedId"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/update": {
      "post": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Update documents in MongoDB",
        "description": "Update documents. Upsert is enabled by default and will only be disabled when upsert is explicitly false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query", "update"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "Query filter (must be a non-empty object)",
                    "minProperties": 1,
                    "example": {
                      "_id": "123"
                    }
                  },
                  "update": {
                    "type": "object",
                    "description": "Update operators",
                    "example": {
                      "$set": {
                        "status": "updated"
                      }
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "MongoDB update options. `upsert` defaults to true unless explicitly set to false.",
                    "example": {
                      "upsert": true
                    }
                  },
                  "upsert": {
                    "type": ["boolean", "string"],
                    "description": "Legacy top-level compatibility field. `false` or \"false\" disables upsert; otherwise upsert stays enabled by default.",
                    "example": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "matchedCount": {
                      "type": "integer"
                    },
                    "modifiedCount": {
                      "type": "integer"
                    },
                    "upsertedCount": {
                      "type": "integer"
                    },
                    "upsertedId": {
                      "type": ["string", "null"]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "get": {
        "tags": [
          "Write Operations"
        ],
        "summary": "Example request for /update",
        "responses": {
          "200": {
            "description": "Example",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delete": {
      "post": {
        "tags": [
          "Delete Operations"
        ],
        "summary": "Delete documents from MongoDB",
        "description": "Delete one or multiple documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "Query filter",
                    "example": {
                      "_id": "123"
                    }
                  },
                  "multi": {
                    "type": "boolean",
                    "description": "Delete multiple documents (deleteMany) or single (deleteOne)",
                    "example": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deletedCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/deleteTimeseries": {
      "post": {
        "tags": [
          "Delete Operations",
          "TimeSeries Operations"
        ],
        "summary": "Delete documents from TimeSeries collection",
        "description": "Delete documents with support for time range filtering. Uses deleteMany by default",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "myTimeSeries"
                  },
                  "query": {
                    "type": "object",
                    "description": "Base filter",
                    "example": {
                      "metadata.sensor": "temp_01"
                    }
                  },
                  "timeField": {
                    "type": "object",
                    "description": "Optional time range filter",
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "ISO 8601 start datetime",
                        "example": "2026-01-01T00:00:00Z"
                      },
                      "end": {
                        "type": "string",
                        "description": "ISO 8601 end datetime",
                        "example": "2026-01-31T23:59:59Z"
                      }
                    }
                  },
                  "multi": {
                    "type": "boolean",
                    "description": "Delete multiple (deleteMany) or single (deleteOne)",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "deletedCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/deleteTimeseries_legacy": {
      "post": {
        "tags": [
          "Delete Operations",
          "TimeSeries Operations"
        ],
        "summary": "Delete documents from TimeSeries collection (Legacy - MongoDB 6 compatible)",
        "description": "Delete documents one-by-one for better compatibility with older MongoDB versions. Processes matching documents and deletes them individually",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "myTimeSeries"
                  },
                  "query": {
                    "type": "object",
                    "description": "Base filter",
                    "example": {
                      "metadata.sensor": "temp_01"
                    }
                  },
                  "timeField": {
                    "type": "object",
                    "description": "Optional time range filter",
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "ISO 8601 start datetime",
                        "example": "2026-01-01T00:00:00Z"
                      },
                      "end": {
                        "type": "string",
                        "description": "ISO 8601 end datetime",
                        "example": "2026-01-31T23:59:59Z"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
