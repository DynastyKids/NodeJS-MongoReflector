{
  "openapi": "3.0.3",
  "info": {
    "description": "这是一个MongoDB后端反射器服务器。支持仅前端应用程序通过PAAS平台部署自己的后端来传输他们的数据库数据。",
    "version": "1.0.1",
    "title": "MongoDB 中间件连接器",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "https://nodejs-mongoreflector.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "健康检查",
      "description": "服务器连通性验证"
    },
    {
      "name": "读取操作",
      "description": "从MongoDB查询和检索数据"
    },
    {
      "name": "写入操作",
      "description": "向MongoDB插入和更新数据"
    },
    {
      "name": "删除操作",
      "description": "删除MongoDB集合中的数据"
    },
    {
      "name": "时间序列操作",
      "description": "时间序列集合的特殊操作"
    }
  ],
  "paths": {
    "/ping": {
      "post": {
        "tags": [
          "健康检查"
        ],
        "summary": "检查MongoDB连通性",
        "description": "验证与MongoDB服务器的连接",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB连接字符串",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "数据库名称",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "集合名称",
                    "example": "testCollection"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "连接成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "云连接成功"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "缺少必需参数"
          },
          "500": {
            "description": "连接失败"
          }
        }
      }
    },
    "/find": {
      "post": {
        "tags": [
          "读取操作"
        ],
        "summary": "从MongoDB中查找文档",
        "description": "使用可选过滤器查询文档",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB连接字符串",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "数据库名称",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "集合名称",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "MongoDB查询过滤器",
                    "example": {
                      "status": "active"
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "查找选项（投影、排序等）",
                    "example": {
                      "projection": { "name": 1, "email": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/paginatefind": {
      "post": {
        "tags": [
          "读取操作"
        ],
        "summary": "分页查找文档（DataTables协议）",
        "description": "支持分页、排序和全局搜索的查询文档",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "基础过滤器",
                    "example": {}
                  },
                  "start": {
                    "type": "integer",
                    "description": "跳过文档数量",
                    "example": 0
                  },
                  "length": {
                    "type": "integer",
                    "description": "限制文档数量",
                    "example": 10
                  },
                  "columns": {
                    "type": "array",
                    "description": "列定义",
                    "example": [
                      {
                        "data": "name"
                      },
                      {
                        "data": "email"
                      }
                    ]
                  },
                  "order": {
                    "type": "array",
                    "description": "排序顺序",
                    "example": [
                      {
                        "column": 0,
                        "dir": "asc"
                      }
                    ]
                  },
                  "search": {
                    "type": "object",
                    "description": "全局搜索",
                    "example": {
                      "value": ""
                    }
                  },
                  "draw": {
                    "type": "integer",
                    "description": "DataTables的绘制计数器",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "draw": {
                      "type": "integer"
                    },
                    "recordsTotal": {
                      "type": "integer",
                      "description": "集合中的总记录数"
                    },
                    "recordsFiltered": {
                      "type": "integer",
                      "description": "匹配过滤器的记录数"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/distinct_field": {
      "post": {
        "tags": [
          "读取操作"
        ],
        "summary": "获取字段的不同值",
        "description": "返回指定字段的唯一值数组",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "field_name"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "field_name": {
                    "type": "string",
                    "description": "要获取不同值的字段名称",
                    "example": "status"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": ["active", "inactive", "pending"]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/insert": {
      "post": {
        "tags": [
          "写入操作"
        ],
        "summary": "向MongoDB插入文档",
        "description": "插入单个或多个文档。同时处理单个对象和数组",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "documents"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "documents": {
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "单个文档",
                        "example": {
                          "name": "John",
                          "email": "john@example.com"
                        }
                      },
                      {
                        "type": "array",
                        "description": "多个文档",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  },
                  "options": {
                    "type": "object",
                    "description": "插入选项",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "插入成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "insertedId": {
                          "type": "string"
                        },
                        "insertedIds": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      },
      "get": {
        "tags": [
          "写入操作"
        ],
        "summary": "/insert的示例请求",
        "responses": {
          "200": {
            "description": "示例",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/insertTimeseries": {
      "post": {
        "tags": [
          "写入操作",
          "时间序列操作"
        ],
        "summary": "向时间序列集合插入数据",
        "description": "为时间序列集合插入数据，具有自动时间戳字段处理",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "timeField", "documents"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "description": "MongoDB 连接字符串",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "description": "数据库名称",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "时间序列集合名称",
                    "example": "myTimeSeries"
                  },
                  "timeField": {
                    "type": "object",
                    "description": "时间字段规范",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "时间字段名称",
                        "example": "timestamp"
                      },
                      "val": {
                        "type": "string",
                        "description": "ISO 8601 日期时间字符串",
                        "example": "2026-01-18T10:30:00Z"
                      }
                    }
                  },
                  "documents": {
                    "type": "object",
                    "description": "要插入的文档",
                    "example": {
                      "metadata": {
                        "sensor": "temp_01"
                      },
                      "value": 23.5
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "插入选项",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "插入成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "result": {
                      "type": "object",
                      "description": "包含 insertedId 的插入结果"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/update": {
      "post": {
        "tags": [
          "写入操作"
        ],
        "summary": "在MongoDB中更新文档",
        "description": "更新文档，默认启用自动upsert",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query", "update"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "查询过滤器",
                    "example": {
                      "_id": "123"
                    }
                  },
                  "update": {
                    "type": "object",
                    "description": "更新操作符",
                    "example": {
                      "$set": {
                        "status": "updated"
                      }
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "更新选项（默认：upsert: true）",
                    "example": {
                      "upsert": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "matchedCount": {
                      "type": "integer"
                    },
                    "modifiedCount": {
                      "type": "integer"
                    },
                    "upsertedCount": {
                      "type": "integer"
                    },
                    "upsertedId": {
                      "type": ["string", "null"]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      },
      "get": {
        "tags": [
          "写入操作"
        ],
        "summary": "/update的示例请求",
        "responses": {
          "200": {
            "description": "示例",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delete": {
      "post": {
        "tags": [
          "删除操作"
        ],
        "summary": "从MongoDB删除文档",
        "description": "删除一个或多个文档",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "testCollection"
                  },
                  "query": {
                    "type": "object",
                    "description": "查询过滤器",
                    "example": {
                      "_id": "123"
                    }
                  },
                  "multi": {
                    "type": "boolean",
                    "description": "删除多个文档（deleteMany）或单个文档（deleteOne）",
                    "example": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deletedCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/deleteTimeseries": {
      "post": {
        "tags": [
          "删除操作",
          "时间序列操作"
        ],
        "summary": "从时间序列集合删除文档",
        "description": "删除支持时间范围过滤的文档。默认使用deleteMany",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "myTimeSeries"
                  },
                  "query": {
                    "type": "object",
                    "description": "基础过滤器",
                    "example": {
                      "metadata.sensor": "temp_01"
                    }
                  },
                  "timeField": {
                    "type": "object",
                    "description": "可选时间范围过滤器",
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "ISO 8601开始日期时间",
                        "example": "2026-01-01T00:00:00Z"
                      },
                      "end": {
                        "type": "string",
                        "description": "ISO 8601结束日期时间",
                        "example": "2026-01-31T23:59:59Z"
                      }
                    }
                  },
                  "multi": {
                    "type": "boolean",
                    "description": "删除多个（deleteMany）或单个（deleteOne）",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "deletedCount": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    },
    "/deleteTimeseries_legacy": {
      "post": {
        "tags": [
          "删除操作",
          "时间序列操作"
        ],
        "summary": "从时间序列集合删除文档（传统版本 - MongoDB 6兼容）",
        "description": "逐个删除文档以提高与较旧MongoDB版本的兼容性。处理匹配的文档并逐个删除它们",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mongoURI", "dbName", "collectionName", "query"],
                "properties": {
                  "mongoURI": {
                    "type": "string",
                    "example": "mongodb+srv://user:password@cluster.mongodb.net"
                  },
                  "dbName": {
                    "type": "string",
                    "example": "testDB"
                  },
                  "collectionName": {
                    "type": "string",
                    "example": "myTimeSeries"
                  },
                  "query": {
                    "type": "object",
                    "description": "基础过滤器",
                    "example": {
                      "metadata.sensor": "temp_01"
                    }
                  },
                  "timeField": {
                    "type": "object",
                    "description": "可选时间范围过滤器",
                    "properties": {
                      "start": {
                        "type": "string",
                        "description": "ISO 8601开始日期时间",
                        "example": "2026-01-01T00:00:00Z"
                      },
                      "end": {
                        "type": "string",
                        "description": "ISO 8601结束日期时间",
                        "example": "2026-01-31T23:59:59Z"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "deletedCount": {
                      "type": "integer",
                      "description": "成功删除的文档数量"
                    },
                    "failedCount": {
                      "type": "integer",
                      "description": "删除失败的文档数量"
                    },
                    "totalMatched": {
                      "type": "integer",
                      "description": "匹配过滤器的文档总数"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "错误的请求"
          },
          "500": {
            "description": "服务器错误"
          }
        }
      }
    }
  }
}
