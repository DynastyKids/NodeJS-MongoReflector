# Copy to .env and edit. Every setting is optional.
# 复制为 .env 后修改。所有配置均为可选。

PORT=3000

# --- Access control / 访问控制 -------------------------------------------
# false = only users below with an unexpired key may call POST endpoints
#         (key sent as X-Api-Key or Authorization: Bearer). true / unset = public.
# false = 仅允许下列用户（key 未过期）访问 POST 接口；true 或不设置 = 公开访问
# ALLOW_PUBLIC_USE=true
# expiry: Unix epoch time in milliseconds (or seconds). 过期时间戳（毫秒或秒）
# ALLOWED_KEYPAIRS=[
#     {user:"warehouse_syd",token:"replace-with-a-long-random-token",expiry:2524651200000},
#     {user:"warehouse_mel",token:"replace-with-another-random-token",expiry:2524651200000},
# ]
# CORS origins allowed to call from a browser (default: any)
# ALLOWED_ORIGINS=https://app.example.com
# POST requests per client IP per minute (0 = off)
# RATE_LIMIT_PER_MINUTE=0
# Set to 1 when running behind Vercel / Render / Nginx so the real client IP is used
# TRUST_PROXY=1
# Reject all write / delete endpoints
# READ_ONLY=false

# --- Where requests may connect / 允许连接的数据库 -----------------------
# Used when a request has no mongoURI (keeps credentials out of the frontend).
# NOTE: MONGO_URI is NOT read by the server.
# DEFAULT_MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
# Set to false to refuse mongoURI sent by clients (use with DEFAULT_MONGO_URI)
# ALLOW_CLIENT_MONGO_URI=true
# Hosts a client mongoURI may point to
# ALLOWED_MONGO_HOSTS=*.mongodb.net
# Refuse hosts that resolve to private / loopback / cloud-metadata addresses
# BLOCK_PRIVATE_HOSTS=false
# Allow tlsCAFile, tlsCertificateKeyFile, proxyHost, authMechanism=MONGODB-AWS/MONGODB-OIDC/GSSAPI
# ALLOW_UNSAFE_URI_OPTIONS=false

# --- Query features / 查询功能 ------------------------------------------
# Allow $where / $function / $accumulator
# ALLOW_SERVER_SIDE_JS=false
# Allow $out / $merge in /aggregate
# ALLOW_AGGREGATE_WRITES=false
# Convert {"$oid": ...}, {"$date": ...} and other Extended JSON wrappers
# EJSON_INPUT=true

# --- Limits / 限制 -------------------------------------------------------
# MAX_TIME_MS=60000
# MAX_FIND_RESPONSE_BYTES=33554432
# MAX_PAGINATE_LENGTH=500
# MAX_DISTINCT_VALUES=10000
# BODY_LIMIT=1mb
# SERVER_SELECTION_TIMEOUT_MS=10000
# MAX_CACHED_CLIENTS=50
# CLIENT_IDLE_TIMEOUT_MS=600000
